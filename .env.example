# Адрес сайта (для sitemap, canonical, ссылок в уведомлениях)
NEXT_PUBLIC_SITE_URL=https://example.vercel.app
NEXT_PUBLIC_SITE_NAME=Платформа домов

# Хранилище: Upstash Redis, либо DATA_DIR для своего сервера (файл kv.json). Без обоих данные в памяти.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Telegram: один бот. Админ-чат получает копию всей переписки.
TG_TOKEN=
TG_ADMIN_CHAT_ID=
NEXT_PUBLIC_TG_BOT=your_bot_username
# TG_API_BASE=https://your-relay   # если Telegram недоступен напрямую
# TG_WEBHOOK_SECRET=               # необязательно, иначе выводится из токена

# Ключ для /admin и настройки webhook
ADMIN_KEY=change-me

# Показать демо-компании (только для проверки вёрстки, не для боевого сайта)
SEED_DEMO=0
DATA_DIR=

# Вход и подтверждение телефона по SMS (SMS.ru). Без ключа вход по SMS отключён.
SMS_RU_API_ID=
# Только для проверки без оплаты: код пишется в лог и показывается на экране. На боевом сайте не включать.
# SMS_DEV=1
